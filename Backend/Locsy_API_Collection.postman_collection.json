{
  "info": {
    "name": "Locsy API - Complete Collection",
    "description": "Collection completa per testare tutte le API di Locsy\n\n**Setup:**\n1. Registrati come utente normale\n2. Copia il token JWT\n3. Incollalo nella variabile {{authToken}}\n4. Testa le route autenticate\n5. Crea un utente admin nel DB\n6. Login come admin e testa route admin\n\n**Variabili:**\n- baseUrl: http://localhost:5000\n- authToken: (inserire dopo login)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', response.token);",
                  "    console.log('Token salvato:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mario\",\n  \"cognome\": \"Rossi\",\n  \"email\": \"mario.rossi@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', response.token);",
                  "    console.log('Token salvato:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mario.rossi@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Notizie",
      "item": [
        {
          "name": "Get All Notizie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notizie",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notizie"]
            }
          }
        },
        {
          "name": "Create Notizia (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titolo\": \"Nuova pista ciclabile inaugurata\",\n  \"contenuto\": \"Il Comune è orgoglioso di annunciare l'apertura della nuova pista ciclabile lungo il fiume. L'inaugurazione si terrà sabato prossimo.\",\n  \"categoria\": \"Viabilità\",\n  \"pubblicata\": true,\n  \"inEvidenza\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notizie",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notizie"]
            }
          }
        },
        {
          "name": "Like Notizia",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notizie/:id/like",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notizie", ":id", "like"],
              "variable": [{"key": "id", "value": "NOTIZIA_ID"}]
            }
          }
        }
      ]
    },
